HOST=0.0.0.0
PORT=8087
DATABASE_URL=postgresql://tack:tack@localhost:5432/tack
OAUTH2_JWKS_URL=http://localhost:8081/oauth2/jwks   # ullav-user-management
OAUTH2_ISSUER=http://localhost:8081                 # ullav-user-management
OPENSEARCH_URL=http://localhost:9200
RUST_LOG=info

# Local embedding model (fastembed / ONNX Runtime). EMBEDDING_MODEL_CACHE_DIR
# should point at a persistent volume in any deployed environment so the
# model survives container restarts/redeploys. EMBEDDING_INTRA_THREADS caps
# ONNX Runtime's own thread pool -- see Config::embedding_intra_threads'
# doc comment (src/config.rs) before raising this above the default of 1:
# fastembed's own default (std::thread::available_parallelism()) reads the
# *host's* full core count in most container schedulers, not the pod's
# actual memory/CPU allotment, and has caused real startup OOM kills in
# production on nodes with many cores.
EMBEDDING_MODEL_CACHE_DIR=./.embedding-models
EMBEDDING_INTRA_THREADS=1
