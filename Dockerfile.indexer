# tack-indexer: the outbox-draining worker that keeps OpenSearch in sync
# with Postgres. Same crate as tack-server (two [[bin]]s), built and
# deployed as its own container/process so indexing load never competes
# with the API server's request-serving resources.
#
# ── Build stage ───────────────────────────────────────────────────────────────
FROM rust:1.91-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config \
        libssl-dev \
        curl \
        g++ \
    && rm -rf /var/lib/apt/lists/*
# g++ (libstdc++) is required at link time by fastembed's dependencies
# (onnxruntime via `ort`, `onig` for tokenizer regex) -- see Dockerfile's
# comment for the same fix.

# Path dependency — checked out as a sibling in CI and copied here.
COPY ullav-mcp-auth /ullav-mcp-auth

# Cache dependencies before copying source
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src/bin \
    && echo 'fn main(){}' > src/main.rs \
    && echo 'fn main(){}' > src/bin/tack-indexer.rs \
    && echo '' > src/lib.rs
RUN cargo build --release
# See Dockerfile's comment: must clear lib* artifacts and .fingerprint too,
# not just the deps/tack_server*/tack_indexer* binary artifacts.
RUN rm -rf target/release/deps/*tack_server* target/release/deps/*tack_indexer* \
           target/release/.fingerprint/tack-server-*

# Build real binary
COPY src ./src
COPY migrations ./migrations
RUN cargo build --release --bin tack-indexer

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1001 tack
WORKDIR /app

COPY --from=builder /app/target/release/tack-indexer ./tack-indexer
# See Dockerfile's comment: the embedding model cache dir needs to be
# writable by the unprivileged `tack` user.
RUN mkdir -p .embedding-models && chown -R tack:tack /app

USER tack

CMD ["./tack-indexer"]
